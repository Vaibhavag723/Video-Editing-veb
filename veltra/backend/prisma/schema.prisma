// Veltra API — Prisma schema
// Node.js/NestJS + PostgreSQL. Timeline documents are stored as Json.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ---------------------------------------------------------------- enums ----
enum Role {
  USER
  EDITOR
  ADMIN
}

enum UserStatus {
  ACTIVE
  PENDING
  SUSPENDED
}

enum ProjectStatus {
  DRAFT
  EDITING
  RENDERING
  EXPORTED
  ARCHIVED
}

enum MediaKind {
  VIDEO
  AUDIO
  IMAGE
  STICKER
  FONT
}

enum ExportStatus {
  QUEUED
  RENDERING
  COMPLETE
  FAILED
}

enum SubscriptionStatus {
  TRIALING
  ACTIVE
  PAST_DUE
  CANCELED
}

enum PlatformContentStatus {
  DRAFT
  REVIEW
  PUBLISHED
  SCHEDULED
}

enum QuestionStatus {
  OPEN
  REPLIED
  RESOLVED
}

// ---------------------------------------------------------------- models ----
model User {
  id              String     @id @default(cuid())
  email           String     @unique
  passwordHash    String?
  fullName        String
  avatarUrl       String?
  role            Role       @default(USER)
  status          UserStatus @default(PENDING)
  emailVerifiedAt DateTime?
  plan            Plan?      @relation(fields: [planId], references: [id])
  planId          String?

  projects     Project[]
  mediaAssets  MediaAsset[]
  exports      Export[]
  subscription Subscription?
  sessions     Session[]
  loginEvents  LoginEvent[]
  activities   Activity[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([role])
  @@index([status])
}

model Session {
  id          String   @id @default(cuid())
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash   String
  refreshHash String?
  ipAddress   String?
  userAgent   String?
  expiresAt   DateTime
  createdAt   DateTime @default(now())

  @@index([userId])
  @@index([expiresAt])
}

model LoginEvent {
  id        String   @id @default(cuid())
  userId    String?
  user      User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  email     String
  provider  String // EMAIL | GOOGLE | MAGIC_LINK
  success   Boolean
  ipAddress String?
  userAgent String?
  createdAt DateTime @default(now())

  @@index([createdAt])
  @@index([email])
}

model Plan {
  id            String         @id @default(cuid())
  slug          String         @unique // free | pro | agency
  name          String
  priceCents    Int
  interval      String // month | year
  features      Json           @default("{}")
  active        Boolean        @default(true)
  users         User[]
  subscriptions Subscription[]
  createdAt     DateTime       @default(now())

  @@index([active])
}

model Subscription {
  id                   String             @id @default(cuid())
  userId               String             @unique
  user                 User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  planId               String
  plan                 Plan               @relation(fields: [planId], references: [id])
  status               SubscriptionStatus @default(TRIALING)
  stripeCustomerId     String?
  stripeSubscriptionId String?            @unique
  currentPeriodStart   DateTime?
  currentPeriodEnd     DateTime?
  cancelAtPeriodEnd    Boolean            @default(false)
  createdAt            DateTime           @default(now())
  updatedAt            DateTime           @updatedAt

  @@index([status])
}

model Project {
  id           String        @id @default(cuid())
  ownerId      String
  owner        User          @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  templateId   String?
  title        String
  description  String?
  status       ProjectStatus @default(EDITING)
  durationSec  Int           @default(0)
  sizeBytes    BigInt        @default(0)
  timeline     Json          @default("{}") // clips, tracks, captions, effects
  thumbnailId  String?
  collaborators Json         @default("[]") // emails + roles

  mediaAssets MediaAsset[]
  exports     Export[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([ownerId])
  @@index([status])
  @@index([updatedAt])
}

model MediaAsset {
  id          String    @id @default(cuid())
  ownerId     String
  owner       User      @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  projectId   String?
  project     Project?  @relation(fields: [projectId], references: [id], onDelete: SetNull)
  kind        MediaKind
  fileName    String
  mimeType    String
  sizeBytes   BigInt
  storageKey  String    @unique // object-storage key
  width       Int?
  height      Int?
  durationSec Float?
  meta        Json      @default("{}")
  createdAt   DateTime  @default(now())

  @@index([ownerId])
  @@index([projectId])
}

model Export {
  id           String       @id @default(cuid())
  projectId    String
  project      Project      @relation(fields: [projectId], references: [id], onDelete: Cascade)
  userId       String
  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  status       ExportStatus @default(QUEUED)
  resolution   String // 720p | 1080p | 2k | 4k
  fps          Int          @default(30)
  format       String // mp4 | webm | mov
  outputUrl    String?
  errorMessage String?
  sizeBytes    BigInt?
  durationSec  Int?
  renderJobId  String?
  startedAt    DateTime?
  finishedAt   DateTime?
  createdAt    DateTime     @default(now())

  @@index([projectId])
  @@index([status])
  @@index([userId, createdAt])
}

model Page {
  id          String                @id @default(cuid())
  slug        String                @unique
  title       String
  contentJson Json                  @default("{}")
  status      PlatformContentStatus @default(DRAFT)
  authorId    String?
  updatedAt   DateTime              @updatedAt
  createdAt   DateTime              @default(now())

  @@index([status])
}

model BlogPost {
  id          String                @id @default(cuid())
  slug        String                @unique
  title       String
  excerpt     String?
  bodyJson    Json                  @default("{}")
  tag         String?
  coverKey    String?
  status      PlatformContentStatus @default(DRAFT)
  authorId    String?
  publishedAt DateTime?
  viewCount   Int                   @default(0)
  createdAt   DateTime              @default(now())
  updatedAt   DateTime              @updatedAt

  @@index([status])
  @@index([publishedAt])
}

model Question {
  id        String         @id @default(cuid())
  email     String
  subject   String
  message   String
  priority  String         @default("MEDIUM") // HIGH | MEDIUM | LOW
  status    QuestionStatus @default(OPEN)
  repliedAt DateTime?
  createdAt DateTime       @default(now())

  @@index([status])
  @@index([createdAt])
}

model Activity {
  id        String   @id @default(cuid())
  userId    String?
  user      User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  type      String // SIGNUP | EXPORT | PAYMENT | LOGIN | PROJECT_UPDATE
  message   String
  meta      Json     @default("{}")
  createdAt DateTime @default(now())

  @@index([userId])
  @@index([createdAt])
}