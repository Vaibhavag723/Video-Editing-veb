# Base URL of the backend API (see backend/.env for the server port).
VITE_API_URL=http://localhost:5000/api

# Web client id for "Sign in with Google" (uses the account you are logged into
# in the browser). Create an OAuth client at https://console.cloud.google.com/
# and paste its id here. Leave empty to use the local demo Google sign-in that
# lets you test the flow without real Google credentials.
VITE_GOOGLE_CLIENT_ID=
