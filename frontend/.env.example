# Base URL of the backend API (see backend/.env for the server port).
VITE_API_URL=http://localhost:5000/api

# Web client id for "Sign in with Google" (uses the account you are logged into
# in the browser). Create an OAuth client at https://console.cloud.google.com/
# and paste its id here. Leave empty to use the local demo Google sign-in that
# lets you test the flow without real Google credentials.
VITE_GOOGLE_CLIENT_ID=

# Minutes of inactivity before a signed-in user gets a 60-second "Still there?"
# warning and is then signed out. Not counted while a video plays or exports.
# 0 disables the idle timeout. Default: 30.
VITE_IDLE_TIMEOUT_MINUTES=30

# Set to 1 to serve `npm run dev` over HTTPS using backend/certs (create them
# first with `npm run cert:dev` in backend/). Pair with SSL_* in backend/.env.
VITE_DEV_HTTPS=
