# Set to "production" on a real server. This is the master switch for
# several protections in server.js and util/errors.js: raw error details are
# hidden from API responses, the server refuses to boot with a missing/weak
# JWT_SECRET, and you get a warning if ALLOWED_ORIGINS isn't set. Leave as
# "development" for local work.
NODE_ENV=development

PORT=5000
DATABASE_URL=postgres://postgres:postgres@localhost:5432/cutroom
# Set EMBEDDED_PG=0 to disable the automatic embedded PostgreSQL fallback.
# When no external PostgreSQL is reachable, the backend boots its own cluster
# (data stored in backend/.pgdata) so `npm start` / `npm run dev` just work.
EMBEDDED_PG=1

# Required. Signs session tokens issued at login/signup. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
# Keep this secret and never commit the real value.
JWT_SECRET=

# CORS allowlist — comma-separated frontend origins allowed to call this API
# from a browser, e.g.
# ALLOWED_ORIGINS=https://vidiocut.com,https://www.vidiocut.com
# Also enforced as the Origin check on the cookie endpoints (/auth/refresh,
# /auth/logout, /auth/logout-all). Leave empty in local dev to allow any origin.
# The API only permits the methods GET, POST, PUT, PATCH, DELETE, OPTIONS and
# the headers Content-Type, Authorization, X-Requested-With.
ALLOWED_ORIGINS=

# ---- HTTPS / SSL certificate ------------------------------------------------
# Two supported setups:
#
#  A) Reverse proxy terminates TLS (the usual production setup — Nginx,
#     Render, Heroku, Cloudflare...). Leave SSL_KEY_PATH/SSL_CERT_PATH empty,
#     set TRUST_PROXY=1 below and NODE_ENV=production. Real certificates come
#     from Let's Encrypt via certbot — see deploy/nginx.conf.example.
#
#  B) Node terminates TLS itself (a standalone VM). Point these at a real
#     certificate + private key (e.g. /etc/letsencrypt/live/<domain>/...).
#     Only TLS 1.2 and 1.3 are accepted.
#
# For local HTTPS testing generate a throwaway self-signed pair with
#   npm run cert:dev
# then set SSL_KEY_PATH=./certs/dev-key.pem and SSL_CERT_PATH=./certs/dev-cert.pem
# (browsers warn about self-signed certs — expected; and backend/certs/ is
# gitignored so the private key is never committed).
SSL_KEY_PATH=
SSL_CERT_PATH=

# Redirect plain HTTP to HTTPS. Automatic when NODE_ENV=production; set to 1 to
# force it in any environment. GET/HEAD are redirected (308); other methods are
# refused with 426 because a password or cookie would already have been sent.
FORCE_HTTPS=
# Canonical public hostname used as the redirect target (recommended in
# production, so the redirect never depends on the request's Host header).
PUBLIC_HOST=
# Option B only: also listen here (e.g. 80) and redirect visitors to the HTTPS port.
HTTP_REDIRECT_PORT=

# SameSite policy of the httpOnly refresh-token cookie:
#   lax    (default) frontend and API share a registrable domain, or localhost
#   strict same-site only, strongest
#   none   frontend and API are on completely different domains; browsers only
#          accept this with the Secure flag, which is forced on automatically
COOKIE_SAMESITE=lax

# Set to 1 when running behind a reverse proxy/load balancer, so Express
# trusts the X-Forwarded-* headers it sets (needed for the rate limiter and
# refresh-token cookie's `secure` flag to see the real client IP/protocol
# instead of the proxy's). Leave unset for local development.
TRUST_PROXY=

# Default admin account, created once on first boot if no admin exists yet.
# If ADMIN_PASSWORD is left empty, a random password is generated and
# printed to the server console on first run — check the logs after
# `npm start` the first time and change it from the admin panel.
ADMIN_EMAIL=admin@cutroom.com
ADMIN_PASSWORD=

# Base URL of the frontend app — used to build the password-reset link that is
# emailed by the "Forgot password" flow.
APP_URL=http://localhost:5173

# SMTP settings. When SMTP_HOST is set (with SMTP_FROM) the backend sends real
# reset emails through nodemailer. When left empty the server runs in dev mode:
# reset links are printed to the console and returned by the API so the flow can
# be tested locally without a mail server.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM=Cutroom <noreply@cutroom.com>

# Google sign-in — "continue with the account you are logged into in the browser".
# Create an OAuth client at https://console.cloud.google.com/ and set its web
# client id here. The frontend reads the same id from VITE_GOOGLE_CLIENT_ID
# (frontend/.env). When GOOGLE_CLIENT_ID is unset the backend runs in demo mode
# and the frontend's Google button calls /auth/google/dev instead.
GOOGLE_CLIENT_ID=
# The demo Google sign-in (/auth/google/dev) is only ever allowed to create a
# brand-new throwaway account — it can never sign in to an existing one, so it
# is not an auth-bypass risk even if left on. Even so, it defaults to OFF when
# NODE_ENV=production; set GOOGLE_DEV_LOGIN=1 to explicitly allow it in
# production (e.g. for a staging/demo deploy), or =0 to disable it anywhere.
GOOGLE_DEV_LOGIN=1
